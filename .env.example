# ─────────────────────────────────────────────────────────
# MediConnect Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to Git — it's in .gitignore
# ─────────────────────────────────────────────────────────

# Email credentials for notification service
# Use a Gmail App Password (not your regular Gmail password)
# How to get it: Google Account → Security → 2-Step Verification → App Passwords
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# MongoDB (leave as-is for local Docker, update for MongoDB Atlas)
MONGO_URI=mongodb://mongodb:27017

# JWT Secret (Base64 encoded — keep this secret!)
JWT_SECRET=bWVkaWNvbm5lY3Qtc2VjcmV0LWtleS1mb3ItaGVhbHRoY2FyZS1wbGF0Zm9ybQ==
