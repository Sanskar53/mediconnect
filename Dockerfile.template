# ── Stage 1: Build ──────────────────────────────────────────────────────────
# Use Maven to compile and package the jar
FROM maven:3.9.5-eclipse-temurin-17 AS builder

WORKDIR /app

# Copy pom files first (better Docker layer caching)
COPY pom.xml .
COPY src ./src

# Package the app, skip tests for faster builds
RUN mvn clean package -DskipTests

# ── Stage 2: Run ────────────────────────────────────────────────────────────
# Use a lightweight JRE image to run the jar
FROM eclipse-temurin:17-jre-alpine

WORKDIR /app

# Copy only the built jar from the builder stage
COPY --from=builder /app/target/*.jar app.jar

# Expose the port (each service has its own)
EXPOSE 8080

# Run the jar
ENTRYPOINT ["java", "-jar", "app.jar"]
